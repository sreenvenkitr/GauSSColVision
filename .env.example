# GauSSColVision Configuration Template
# Copy this file to .env and configure your credentials.

# Active VLM Provider: "gemini" or "openrouter" / "openai"
VISION_PROVIDER=gemini

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
VISION_GEMINI_MODEL=gemini-flash-lite-latest

# --- OpenRouter / OpenAI-Compatible Configuration ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Server & Inference Configuration ---
VISION_HOST=127.0.0.1
VISION_PORT=8010
VISION_DEVICE=auto
VISION_DTYPE=bfloat16
VISION_USE_MOCK_MODEL=false

# --- SAM 2.1 Configuration ---
SAM_ENABLED=true
SAM_MODEL=facebook/sam2.1-hiera-tiny
SAM_DEVICE=auto
SAM_MIN_MASK_CONFIDENCE=0.5
SEMANTIC_SELECTION_MIN_VIEW_SUPPORT=1
